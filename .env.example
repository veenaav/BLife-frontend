# ==============================================================================
# Vasudha App (B-Liffe Frontend) - Environment Template
# ==============================================================================

# Routing Base Path ('/' for standard AWS S3 + CloudFront CDN hosting)
VITE_BASE_URL="/"

# Backend API Endpoint:
# In production with CloudFront, leave EMPTY to route via same-origin '/api'
# (eliminates CORS and mixed-content issues).
# If using a separate custom API domain: https://api.yourdomain.org
VITE_API_URL=

# Local Vite Dev Server Settings
VITE_PORT=5173
VITE_PROXY_TARGET=http://localhost:3000

# Mapbox Access Token (required for high-resolution satellite/outdoors map layers)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Default Map Center Coordinates & Zoom
VITE_DEFAULT_LATITUDE=8.5241
VITE_DEFAULT_LONGITUDE=76.9366
VITE_DEFAULT_ZOOM=16
